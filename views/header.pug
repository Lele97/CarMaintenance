header.app-navbar
  .container-xl
    .navbar-layout
      .vehicle-pill(aria-label="Veicolo selezionato")
        i.bi.bi-car-front-fill.me-2(aria-hidden="true")
        span Veicolo principale

      a.brand-title(href="/" title="Vai alla Dashboard" aria-label="CarMaintenance, dashboard")
        i.bi.bi-speedometer2(aria-hidden="true")
        span
          | Car
          span.brand-accent Maintenance
          span.brand-dot

      nav.navbar-actions(aria-label="Azioni rapide")
        button.btn.btn-sm.btn-nav-secondary.rounded-pill.px-3(
          type="button"
          data-bs-toggle="modal"
          data-bs-target="#exportImportModal"
          title="Esporta o importa dossier manutenzioni"
        )
          i.bi.bi-arrow-down-up.me-1(aria-hidden="true")
          span Dossier

        a.btn.btn-sm.btn-nav-primary.rounded-pill.px-3(href="/add" title="Inserisci nuovo intervento")
          i.bi.bi-plus-lg.me-1(aria-hidden="true")
          span Nuovo
