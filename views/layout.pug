doctype html
html(lang="it")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    meta(name="description" content="CarMaintenance - Gestione e monitoraggio intelligente della manutenzione del veicolo")
    meta(name="theme-color" content="#090D16")
    meta(name="apple-mobile-web-app-capable" content="yes")
    title= title || 'CarMaintenance - Dashboard Manutenzione'
    link(rel="manifest" href="/manifest.webmanifest")
    link(href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet")
    link(href="/bootstrap-icons/bootstrap-icons.css" rel="stylesheet")
    link(rel="stylesheet" href="/css/style.css")

  body.wrapper(data-storage-mode=(storageMode || 'mongodb'))
    include header

    main.flex-grow-1
      block content

    include footer

    script(src="/vendor/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/vendor/chart.js/chart.umd.min.js")
    script(src="/js/storage.js")
    script(src="/js/dashboard.js")
