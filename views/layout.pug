doctype html
html(lang="it")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    meta(name="description" content="CarMaintenance - Gestione e monitoraggio intelligente della manutenzione del veicolo")
    meta(name="theme-color" content="#090D16")
    title= title || 'CarMaintenance - Dashboard Manutenzione'

    // Google Fonts - Inter
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet")

    // Bootstrap 5 & Icons
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous")
    link(href="/bootstrap-icons/bootstrap-icons.css" rel="stylesheet")

    // Custom Modern Design System
    link(rel="stylesheet" href="/css/style.css")

  body.wrapper(data-storage-mode=(storageMode || 'mongodb'))
    include header

    main.flex-grow-1
      block content

    include footer

    // Bootstrap JS
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous")

    // Chart.js per visualizzazioni e statistiche
    script(src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js")

    // Browser Storage Engine & Dashboard scripts
    script(src="/js/mileageReadings.js")
    script(src="/js/storage.js")
    script(src="/js/dashboard.js")
