footer.app-footer
  .container-xl
    .footer-layout
      a.footer-brand(href="/" aria-label="CarMaintenance, dashboard")
        i.bi.bi-wrench-adjustable-circle-fill(aria-hidden="true")
        span
          | Car
          span.brand-accent Maintenance

      p.footer-description.mb-0 Traccia e conserva lo storico manutenzioni del tuo veicolo.

      nav.footer-links(aria-label="Collegamenti rapidi")
        a(href="/" title="Dashboard") Dashboard
        a(href="/add" title="Nuovo intervento") Nuovo intervento
        a(href="https://github.com/Lele97/CarMaintenance" target="_blank" rel="noopener noreferrer")
          i.bi.bi-github.me-1(aria-hidden="true")
          | GitHub

    .footer-bottom
      span CarMaintenance
      span Manutenzione, senza sorprese.
