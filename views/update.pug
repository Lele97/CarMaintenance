extends layout

block content
  .container.py-5
    .row.justify-content-center
      .col-lg-8.col-xl-7
        .card.custom-form-card.shadow-lg.border-0
          .card-header.bg-transparent.border-0.pt-4.pb-0.text-center
            .d-inline-flex.align-items-center.justify-content-center.icon-badge.mb-3
              i.bi.bi-pencil-square.text-primary.fs-3
            h1.h3.fw-bold.text-slate-900 Modifica Intervento
            p.text-muted.small Aggiorna i dati relativi all'operazione di manutenzione

          .card-body.p-4.p-md-5
            if errors && Object.keys(errors).length > 0
              .alert.alert-danger.rounded-3.mb-4(role="alert")
                .d-flex.align-items-center.mb-2
                  i.bi.bi-exclamation-triangle-fill.me-2
                  strong.fw-bold Si sono verificati alcuni errori:
                ul.mb-0.ps-3.small
                  each err in errors
                    li= err

            - const itemId = intervention ? (intervention._id || intervention.id) : ''
            - let formattedDate = ''
            - if (intervention && intervention.dateFormatted) { formattedDate = intervention.dateFormatted }
            - else if (intervention && intervention.date) {
            -   try {
            -     formattedDate = typeof intervention.date === 'string' ? intervention.date.slice(0, 10) : new Date(intervention.date).toISOString().slice(0, 10)
            -   } catch(e) { formattedDate = '' }
            - }

            form(action='/update/' + itemId method="post" novalidate)
              input(type="hidden" name="_method" value="put")
              .row.g-3
                .col-md-6
                  label.form-label.fw-semibold(for="date")
                    i.bi.bi-calendar-event.me-1.text-primary
                    |  Data dell'intervento *
                  input#date.form-control.custom-input(
                    type="date"
                    name="date"
                    required
                    value=formattedDate
                    class=(errors && errors.date ? 'is-invalid' : '')
                  )
                  if errors && errors.date
                    .invalid-feedback= errors.date

                .col-md-6
                  label.form-label.fw-semibold(for="categoria")
                    i.bi.bi-tag.me-1.text-primary
                    |  Categoria *
                  select#categoria.form-select.custom-input(name="categoria")
                    each cat in (categories || ['Tagliando', 'Olio e Filtri', 'Freni', 'Pneumatici', 'Batteria', 'Revisione', 'Riparazione Meccanica', 'Carrozzeria', 'Altro'])
                      option(value=cat selected=(intervention && intervention.categoria === cat))= cat

                .col-md-6
                  label.form-label.fw-semibold(for="kilometri")
                    i.bi.bi-speedometer2.me-1.text-primary
                    |  Chilometraggio (km) *
                  input#kilometri.form-control.custom-input(
                    type="number"
                    name="kilometri"
                    min="0"
                    max="2000000"
                    required
                    value=(intervention ? intervention.kilometri : '')
                    class=(errors && errors.kilometri ? 'is-invalid' : '')
                  )
                  if errors && errors.kilometri
                    .invalid-feedback= errors.kilometri

                .col-md-6
                  label.form-label.fw-semibold(for="costo")
                    i.bi.bi-currency-euro.me-1.text-primary
                    |  Costo totale (€) *
                  input#costo.form-control.custom-input(
                    type="number"
                    step="0.01"
                    name="costo"
                    min="0"
                    max="1000000"
                    required
                    value=(intervention ? intervention.costo : '')
                    class=(errors && errors.costo ? 'is-invalid' : '')
                  )
                  if errors && errors.costo
                    .invalid-feedback= errors.costo

                .col-12
                  label.form-label.fw-semibold(for="intervento")
                    i.bi.bi-wrench-adjustable.me-1.text-primary
                    |  Descrizione dell'intervento *
                  textarea#intervento.form-control.custom-input(
                    name="intervento"
                    rows="3"
                    required
                    class=(errors && errors.intervento ? 'is-invalid' : '')
                  )=(intervention ? intervention.intervento : '')
                  if errors && errors.intervento
                    .invalid-feedback= errors.intervento

                .col-md-6
                  label.form-label.fw-semibold(for="veicolo")
                    i.bi.bi-car-front.me-1.text-primary
                    |  Veicolo
                  input#veicolo.form-control.custom-input(
                    type="text"
                    name="veicolo"
                    value=(intervention && intervention.veicolo ? intervention.veicolo : 'Veicolo Principale')
                  )

                .col-md-6
                  label.form-label.fw-semibold(for="note")
                    i.bi.bi-sticky.me-1.text-primary
                    |  Note / Officina
                  input#note.form-control.custom-input(
                    type="text"
                    name="note"
                    value=(intervention && intervention.note ? intervention.note : '')
                  )

              .d-flex.align-items-center.justify-content-between.mt-4.pt-3.border-top
                a.btn.btn-outline-secondary.rounded-pill.px-4(href="/")
                  i.bi.bi-arrow-left.me-1
                  |  Annulla
                button.btn.btn-primary-custom.rounded-pill.px-5.py-2.fw-bold(type="submit")
                  i.bi.bi-arrow-repeat.me-1
                  |  Aggiorna Intervento
