# Server Configuration
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Storage Mode: 'mongodb' for backend database, 'browser' for client-side storage (IndexedDB)
STORAGE_MODE=mongodb

# MongoDB Connection (used in development or when STORAGE_MODE=mongodb)
MONGODB_URI=mongodb://127.0.0.1:27017/carmaintenance
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/carmaintenance_test

# Ngrok Tunneling (disabled by default for security; set ENABLE_NGROK=true to enable)
ENABLE_NGROK=false
NGROK_AUTHTOKEN=
NGROK_DEBUG=0
