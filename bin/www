#!/usr/bin/env node

/**
 * Module dependencies.
 */
require('dotenv').config();
var app = require('../app');
var debug = require('debug')('carmaintenance:server');
var http = require('http');
const ngrok = require('@ngrok/ngrok');

/**
 * Get port from environment and store in Express.
 */
const port = normalizePort(process.env.PORT || 4000);
const startupType = process.env.STARTUP_TYPE || 'development';
app.set('port', port);

// Create HTTP server
const server = http.createServer(app);

server.on('error', onError);
server.on('listening', () => onListening(startupType));
server.listen(port, '0.0.0.0');

function normalizePort(val) {
  const port = parseInt(val, 10);
  if (isNaN(port)) return val;
  if (port >= 0) return port;
  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') throw error;

  const bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;
  switch (error.code) {
    case 'EACCES':
      console.error(`${bind} requires elevated privileges`);
      process.exit(1);
    case 'EADDRINUSE':
      console.error(`${bind} is already in use`);
      process.exit(1);
    default:
      throw error;
  }
}

async function openNgrokTunnel() {
  const tunnelOptions = { addr: port, authtoken_from_env: true };
  if (process.env.NGROK_DEBUG === '1') {
    tunnelOptions.onLogEvent = (message) => console.log(`[ngrok] ${message}`);
  }

  try {
    const listener = await ngrok.forward(tunnelOptions);
    console.log(`ngrok tunnel opened at: ${listener.url()}`);
    console.log('Open the ngrok inspector at: http://127.0.0.1:4000\n');
  } catch (error) {
    const details = error.body && error.body.details && error.body.details.err;
    console.error('Error opening ngrok tunnel:', details || error.message);
  }
}

async function onListening(startupType) {
  const addr = server.address();
  const bind = typeof addr === 'string' ? `pipe ${addr}` : `port ${addr.port}`;
  debug(`🚀 Server listening on ${bind}`);

  if (startupType === 'development') {
    await openNgrokTunnel();
  }else {
    console.log(`Server running in ${startupType} mode. ngrok tunnel not opened.`);
  }

}
